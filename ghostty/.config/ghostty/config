# Ghostty Configuration - Shades of Purple

# Appearance
font-family = "PlemoJP Console"
font-size = 14
cursor-style = bar

# Window & Padding
window-padding-x = 12
window-padding-y = 10
window-decoration = true

# Theme Colors - Shades of Purple
